@startuml abonnements_alarmes_documents
skinparam backgroundColor white
skinparam defaultFontSize 12
hide circle
hide methods

title Abonnements aux alarmes documentaires — schéma

entity membres {
  * mlogin : varchar(25) (PK)
  --
  doc_alarm_personal : tinyint(1)
  doc_alarm_digest_frequency : enum(weekly, daily)
}

entity document_alarm_subscriptions {
  * id : int (PK)
  --
  * subscriber_login : varchar(25) (FK)
  document_type_id : int (FK, null = tous)
  section_id : int (FK, null = toutes)
  archived_document_id : bigint (FK, null = tous)
  * watch_expiring_soon : tinyint(1)
  * watch_expired : tinyint(1)
  * watch_missing : tinyint(1)
  created_at, updated_at
  created_by, updated_by
}

entity notification_history {
  * id : bigint (PK)
  --
  * recipient_login : varchar(25)
  * kind : enum(pilot_*, subscriber_digest)
  archived_document_id : bigint
  document_type_id : int
  * channel, status, error
  * sent_at : datetime
  created_at, updated_at
  created_by, updated_by
}

entity document_types {
  * id : int (PK)
  --
  section_id : int
  is_private, alert_days_before
}

entity sections {
  * id : int (PK)
}

entity archived_documents {
  * id : bigint (PK)
  --
  document_type_id, pilot_login,
  section_id, valid_until, alarm_disabled
}

membres ||--o{ document_alarm_subscriptions : abonné
document_types |o--o{ document_alarm_subscriptions
sections |o--o{ document_alarm_subscriptions
archived_documents |o--o{ document_alarm_subscriptions
membres ||--o{ notification_history : destinataire
document_types ||--o{ archived_documents
@enduml
