@startuml gestion_alarmes_composants
skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam defaultFontSize 12

title Architecture — Gestion Générique des Alarmes GVV (Lot 1)

package "Pages" #lavender {
  component [alarmes_config\n(configuration)] as CONF
  component [mes_alarmes\n(consultation)] as MES
  component [alarmes_admin\n(catalogue, catégories,\nalarmes sans abonné)] as ADM
}

package "Notifications" #mistyrose {
  component [alarm_scheduler\n(cron / URL à secret)] as SCHED
  component [Notification_manager] as NOTIF
}

package "Abonnements" #lightcyan {
  component [alarm_definitions_model\nalarm_subscriptions_model\nalarm_member_settings_model] as SUBS
  database "alarm_definitions\nalarm_subscriptions\nalarm_subscription_optouts\nalarm_member_settings\nnotification_history" as SUBS_DB
}

package "Agrégation" #lightblue {
  component [AlarmAggregator] as AGG
  component [DocumentAlarmProvider] as DOC_P #lightgreen
  component [ComputedAlarmProvider\n(Lot 2)] as COMP_P #lightyellow
}

package "Code existant" {
  component [archived_documents_model] as ARCH_M
  component [licences_model] as LIC_M
  component [motd_model\ngenerate_system_message()] as MOTD
  component [Brevo_sms_adapter] as SMS
  component [Email] as MAIL
  component [formation_inscription_model] as FORM
  database "user_roles_per_section" as ROLES
  component [alarmes.php] as ALARM_C
}

SCHED --> NOTIF
NOTIF --> AGG : occurrences
NOTIF --> SUBS : abonnements effectifs,\nréglages, historique
NOTIF --> MAIL
NOTIF --> MOTD
NOTIF --> SMS

CONF --> SUBS
ADM --> SUBS
ADM --> AGG : alarmes sans abonné
MES --> AGG
MES --> SUBS

SUBS --> SUBS_DB
SUBS --> ROLES : catégories

AGG --> DOC_P
AGG ..> COMP_P : Lot 2
DOC_P --> ARCH_M : expirés, proches,\nmanquants
COMP_P --> LIC_M : vols sans licence,\nvols sans cotisation

FORM --> ROLES : rôle élève\n(ouverture, clôture)

ALARM_C ..> COMP_P : migrera vers\n(lot suivant)

legend right
  Couleur = nouveau composant du Lot 1
  Blanc = existant, réutilisé
endlegend

@enduml
