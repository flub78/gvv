@startuml sauvegarde_hors_site_flow
skinparam sequenceMessageAlign center
skinparam maxMessageSize 160

actor "Cron\n(quotidien)" as Cron
participant "Envoi hors-site\n(rclone_offsite_upload.sh,\nrclone_safe_retention.sh)" as Script
database "backups (local)" as Local
participant "rclone" as Rclone
participant "Google Drive\ndu club" as Drive
participant "Supervision externe\n(Healthchecks.io)" as Smtp
actor "Club\n(email, SMS…)" as Club
database "logfile.txt\n(local)" as Log

Cron -> Script : déclenche l'envoi de chaque type\n(base de données, médias)
Script -> Local : repère la dernière sauvegarde du type\net vérifie qu'elle a moins de 36 h
alt sauvegarde absente ou trop ancienne
    Script -> Log : ALERTE (sauvegarde locale arrêtée ?)
    Script -> Smtp : signal d'échec + fin du log
else sauvegarde récente
    Script -> Rclone : copy
    Rclone -> Drive : upload
    Rclone --> Script : code retour
    alt erreur rclone (jeton expiré, quota…)
        Script -> Log : ALERTE (erreur rclone)
        Script -> Smtp : signal d'échec + fin du log
    else succès
        Script -> Log : envoi OK
        Script -> Smtp : signal de succès
    end
end

Cron -> Script : rclone_safe_retention.sh, par type
Script -> Rclone : liste les copies distantes de moins de 3 jours
alt erreur rclone ou aucune copie récente
    Script -> Log : ALERTE, purge annulée (cause précisée)
else copie récente présente
    Script -> Rclone : purge des fichiers > 3 jours
    Rclone -> Drive : suppression
    Script -> Log : purge OK
end

Smtp -> Club : alerte sur signal d'échec,\nou en l'absence de signal\n(serveur éteint, cron disparu)

@enduml
