@startuml veille_composants
skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam defaultFontSize 12
left to right direction

title Architecture — Veille documentaire (composants)

actor "Administrateur" as ADMIN

package "Agent de rédaction — Claude Code" #mistyrose {
  component [Agent IA\n(consignes, registre des sources,\nétat de la veille, journal)] as AGENT
}

package "Application GVV" #lightblue {
  component [newsletter_admin\n(import, annotation, transmission,\nrelevé des réponses, tri des remarques,\nconsignes de modification, validation, publication)] as CTRL
  component [Importeur\n(.md ou .zip)] as IMPORTER
  component [Récupérateur de réponses] as COLLECT
  component [Générateur de consignes\nde modification (.md ou .zip)] as DIRECTIVES
  component [Mise en forme PDF\net publication] as PUBLISH
  database "MySQL + stockage hors web" as STORE
}

cloud "Sources web, RSS,\ncourriels" as SOURCES
cloud "Boîte veille@" as MAILBOX
actor "Relecteurs, abonnés" as PEOPLE

AGENT --> SOURCES : explore
ADMIN --> AGENT : lance (version initiale,\nou consignes de modification)
AGENT ..> ADMIN : brouillon vN (.md ou .zip)
ADMIN --> CTRL : pilote
CTRL --> IMPORTER
IMPORTER --> STORE
CTRL --> PEOPLE : brouillon annoté (PDF)
PEOPLE --> MAILBOX : réponses
COLLECT --> MAILBOX : lit
COLLECT --> STORE : remarques, images
DIRECTIVES --> STORE : lit
DIRECTIVES ..> ADMIN : consignes de modification
PUBLISH --> STORE
PUBLISH --> PEOPLE : newsletter publiée

@enduml
