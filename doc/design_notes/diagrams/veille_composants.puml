@startuml veille_composants
skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam defaultFontSize 12
left to right direction

title Architecture — Veille documentaire (composants)

actor "Administrateur" as ADMIN

package "Étape 1 — poste de l'administrateur" #mistyrose {
  component [Claude Desktop\n(disque, navigation web)] as DESKTOP
}

package "Application GVV — www-data" #lightblue {
  component [newsletter_admin\n(consignes, paramètres, exécutions, import,\ntransmission, tri des suggestions, validation)] as CTRL
  component [Extracteur de mails] as EXTRACTOR
  component [Importeur d'exécution] as IMPORTER
  component [Récupérateur de réponses, réviseur,\nfinaliseur, surveillance] as JOBS
  database "MySQL + archive hors web" as STORE
}

package "Dossier d'échange /srv/veille" #lightyellow {
  folder "config/\n(consignes, inventaire,\nparamètres, demande)" as XCONF
  folder "inbox/\n(mails extraits)" as XINBOX
  folder "runs/\n(paquets d'exécution)" as XRUNS
}

package "Serveur — veille-agent (étape 2)" #mistyrose {
  component [Timer systemd\n+ lanceur] as LAUNCHER
  component [Claude Code\nnon interactif\n+ navigateur] as AGENT
}

cloud "Sources web, RSS\net boîte veille@" as SOURCES
actor "Relecteurs, validateurs,\nabonnés" as PEOPLE

ADMIN --> CTRL : pilote
ADMIN --> DESKTOP : lance (étape 1)
DESKTOP --> SOURCES : explore
DESKTOP ..> IMPORTER : paquet importé à la main

CTRL --> XCONF : publie
EXTRACTOR --> XINBOX : écrit
LAUNCHER --> AGENT : lance avec plafonds
AGENT --> XCONF : lit
AGENT --> XINBOX : lit
AGENT --> SOURCES : explore
AGENT --> XRUNS : écrit paquet + trace
IMPORTER --> XRUNS : lit

IMPORTER --> STORE
CTRL --> STORE
JOBS --> STORE
CTRL --> PEOPLE : emails (SMTP)
JOBS --> PEOPLE : newsletter publiée, alertes

@enduml
