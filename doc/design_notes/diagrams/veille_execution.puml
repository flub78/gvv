@startuml veille_execution
skinparam backgroundColor white
skinparam defaultFontSize 12

title Exécution automatique (étape 2)

actor "Administrateur" as ADMIN
participant "GVV\n(www-data)" as GVV
participant "systemd" as SYS
participant "Extracteur\n(www-data)" as EXT
participant "Lanceur + agent\n(veille-agent)" as AGENT
participant "Importeur\n(www-data)" as IMP
participant "Relecteurs" as REV

ADMIN -> GVV : modifie consignes / paramètres
GVV -> GVV : publie config/ dans le dossier d'échange
opt Lancement manuel
  ADMIN -> GVV : « Lancer maintenant »
  GVV -> GVV : dépose une demande
end

SYS -> SYS : date atteinte\nou demande détectée
SYS -> EXT : démarre
EXT -> EXT : nouveaux mails veille@ → inbox/
SYS -> AGENT : démarre (durée et coût plafonnés)
AGENT -> AGENT : lit consignes, inventaire, inbox/\nexplore les sources\nécrit brouillon, rapport, inventaire
AGENT -> AGENT : trace des appels d'outils, métadonnées
SYS -> IMP : démarre
alt Paquet complet
  IMP -> GVV : exécution réussie, newsletter « draft »
  GVV -> REV : envoi du brouillon
else Échec ou plafond atteint
  IMP -> GVV : exécution en échec
  GVV -> ADMIN : alerte email
end

@enduml
