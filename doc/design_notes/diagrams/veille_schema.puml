@startuml veille_schema
skinparam backgroundColor white
skinparam defaultFontSize 11

title Schéma de base de données — Veille documentaire

entity newsletters {
  * id : INT PK
  --
  * title : VARCHAR
  * period_start : DATE
  * period_end : DATE
  * status : ENUM(draft, reviewing,\n  validating, approved, published)
  * review_iteration : INT
  draft_path : VARCHAR
  pdf_path : VARCHAR
  approved_by : VARCHAR
  approved_at : DATETIME
  published_at : DATETIME
  --
  * created_at : DATETIME
  * updated_at : DATETIME
  * created_by : VARCHAR
  * updated_by : VARCHAR
}

entity newsletter_reviews {
  * id : INT PK
  --
  newsletter_id : INT FK
  * iteration : INT
  * submitted_via : ENUM(email, gvv)
  message_id : VARCHAR UNIQUE
  * reviewer_email : VARCHAR
  reviewer_name : VARCHAR
  * kind : ENUM(remarque, article)
  * content : TEXT
  * decision : ENUM(en_attente, acceptee,\n  modifiee, rejetee, reportee)
  admin_text : TEXT
  decided_by : VARCHAR
  decided_at : DATETIME
  has_attachments : TINYINT
  --
  * created_at : DATETIME
  * updated_at : DATETIME
  * created_by : VARCHAR
  * updated_by : VARCHAR
}

entity newsletter_subscribers {
  * id : INT PK
  --
  * email : VARCHAR UNIQUE
  * first_name : VARCHAR
  * last_name : VARCHAR
  * confirmed : TINYINT
  confirmation_token : VARCHAR
  * unsubscribe_token : VARCHAR
  confirmed_at : DATETIME
  unsubscribed_at : DATETIME
  --
  * created_at : DATETIME
  * updated_at : DATETIME
  * created_by : VARCHAR
  * updated_by : VARCHAR
}

entity newsletter_sendings {
  * id : INT PK
  --
  * newsletter_id : INT FK
  * subscriber_id : INT FK
  * sent_at : DATETIME
  --
  * created_at : DATETIME
  * updated_at : DATETIME
  * created_by : VARCHAR
  * updated_by : VARCHAR
}

entity newsletter_contexts {
  * id : INT PK
  --
  * version : INT
  * content : MEDIUMTEXT
  comment : VARCHAR
  * is_active : TINYINT
  --
  * created_at : DATETIME
  * updated_at : DATETIME
  * created_by : VARCHAR
  * updated_by : VARCHAR
}

entity newsletter_runs {
  * id : INT PK
  --
  * run_id : VARCHAR UNIQUE
  * origin : ENUM(desktop, schedule,\n  manual)
  * status : ENUM(requested, running,\n  succeeded, failed)
  * context_id : INT FK
  newsletter_id : INT FK
  started_at : DATETIME
  finished_at : DATETIME
  model : VARCHAR
  cost_usd : DECIMAL
  package_path : VARCHAR
  error : TEXT
  --
  * created_at : DATETIME
  * updated_at : DATETIME
  * created_by : VARCHAR
  * updated_by : VARCHAR
}

newsletters |o--o{ newsletter_reviews : contient
newsletters ||--o{ newsletter_sendings : envoyée à
newsletter_subscribers ||--o{ newsletter_sendings : reçoit

newsletter_contexts ||--o{ newsletter_runs : utilisée par
newsletter_runs |o--o| newsletters : produit

@enduml
