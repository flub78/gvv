# GVV — Configuration Apache
# Copiez ce fichier en .htaccess à la racine de l'application GVV.
# Ces directives fonctionnent indépendamment du domaine et du sous-dossier
# dans lequel GVV est déployé.
#
# Note : les directives php_value ne sont actives qu'avec Apache + mod_php.
# Sur hébergement mutualisé (Ionos, OVH, o2switch…), PHP tourne généralement
# en PHP-FPM/FastCGI : sans le <IfModule> ci-dessous, ces lignes provoquent
# une erreur 500 (Invalid command 'php_value'). Avec PHP-FPM, configurez ces
# valeurs dans le pool php-fpm.conf ou via un fichier .user.ini.

# Limites pour les opérations de sauvegarde et restauration
<IfModule mod_php7.c>
php_value memory_limit 1024M
php_value max_execution_time 300
php_value upload_max_filesize 1024M
php_value post_max_size 1024M
</IfModule>
<IfModule mod_php8.c>
php_value memory_limit 1024M
php_value max_execution_time 300
php_value upload_max_filesize 1024M
php_value post_max_size 1024M
</IfModule>

RewriteEngine On
# Certains hébergeurs mutualisés (Ionos notamment) exigent un RewriteBase
# explicite pour que les règles ci-dessous s'appliquent : sans lui, seule la
# racine du site fonctionne (servie via DirectoryIndex) et toute autre URL
# renvoie une 404 sans même atteindre index.php. "/" suppose que le domaine
# ou sous-domaine est mappé directement sur ce répertoire.
RewriteBase /

# Le répertoire tests/ existe sur disque ; cette règle force son routage
# vers le contrôleur CI plutôt que vers la liste du répertoire.
RewriteCond %{REQUEST_URI} /tests(/.*)?$ [OR]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]
