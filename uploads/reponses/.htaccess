# Bloque l'accès web direct aux fichiers de réponses aux formulaires
# (scans, certificats, pièces d'identité joints par les répondants).
#
# Tous les accès légitimes passent par le contrôleur forms_admin
# (actions submission_file/submission_file_thumbnail), qui lit les fichiers
# sur le disque et applique les contrôles de droits : ce blocage n'affecte
# donc pas l'application.
#
# ATTENTION : sur un déploiement nginx en frontal (reverse proxy servant les
# fichiers statiques), ce fichier est ignoré. Appliquer en plus la règle nginx.
# Voir doc/security/exposition_directe_uploads.md
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
