# Bloque l'accès web direct aux archives de sauvegarde/restauration de la base.
# Ces archives ne devraient idéalement pas être stockées sous la racine web.
#
# ATTENTION : sur un déploiement nginx en frontal, ce fichier est ignoré.
# Appliquer en plus la règle nginx.
# Voir doc/security/exposition_directe_uploads.md
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
